+ *****************************************************************************
+ * DRM (ETSI ES 201 980) access units for the AAC-LC / HE-AAC encoder:
+ * ER AAC with VCB11 and HCR (ISO/IEC 14496-3 4.5.2.3, 8.5.3.3), the DRM
+ * aac_crc_bits and the SBR data stored bit-reversed at the end of the AU.
+ * Written for DREAM from the standards; not part of the Ittiam/AOSP sources.
+ */
+
+#pragma once
+
+/* one Huffman codeword of the spectral data (codeword, sign and escape bits) */
+typedef struct {
+  UWORD64 bits; /* right-aligned */
+  WORD32 len;
+  WORD32 cb;
+} ixheaace_drm_cw;
+
+#define IXHEAACE_DRM_MAX_CW (FRAME_LEN_1024 / 2)
+#define IXHEAACE_DRM_LEN_REORD_BITS (14)
+#define IXHEAACE_DRM_LEN_LONGEST_BITS (6)
