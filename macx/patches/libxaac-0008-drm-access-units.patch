+ *****************************************************************************
+ * DRM access-unit helpers (see ixheaace_drm.h). Written for DREAM from
+ * ISO/IEC 14496-3 (8.5.3.3 HCR) and ETSI ES 201 980; not part of the
+ * Ittiam/AOSP sources.
+ */
+
+#include <string.h>
+#include "ixheaac_type_def.h"
+#include "ixheaac_constants.h"
+#include "ixheaace_aac_constants.h"
+#include "ixheaac_basic_ops32.h"
+#include "ixheaac_basic_ops16.h"
+#include "ixheaac_basic_ops40.h"
+#include "ixheaac_basic_ops.h"
+#include "ixheaace_bitbuffer.h"
+#include "ixheaace_psy_const.h"
+#include "ixheaace_tns.h"
+#include "ixheaace_tns_params.h"
+#include "ixheaace_rom.h"
+#include "ixheaace_bits_count.h"
+#include "ixheaace_dynamic_bits.h"
+#include "ixheaace_drm.h"
+
+/* 8.5.3.3.3.1 presorting order of the codebooks with VCB11 */
+static const WORD32 ixheaace_drm_presort[22] = {11, 31, 30, 29, 28, 27, 26, 25, 24, 23, 22,
+                                                21, 20, 19, 18, 17, 16, 9,  7,  5,  3,  1};
+/* 8.5.3.3.3.2 maximum codeword length per codebook */
+static const WORD32 ixheaace_drm_max_cw_len[32] = {0,  11, 9,  20, 16, 13, 11, 14, 12, 17, 14,
+                                                   49, 0,  0,  0,  0,  14, 17, 21, 21, 25, 25,
+                                                   29, 29, 29, 29, 33, 33, 33, 37, 37, 41};
+
+UWORD8 ixheaace_drm_crc8(const UWORD8 *ptr_buf, WORD32 start_bit, WORD32 nbits) {
+  UWORD32 crc = 0xFF;
+  WORD32 i;
+  for (i = 0; i < nbits; i++) {
+    WORD32 pos = start_bit + i;
+    UWORD32 bit = (ptr_buf[pos >> 3] >> (7 - (pos & 7))) & 1;
+    UWORD32 fb = ((crc >> 7) & 1) ^ bit;
+    crc = (crc << 1) & 0xFF;
+    if (fb) crc ^= 0x1D;
+  }
+  return (UWORD8)(~crc & 0xFF);
+}
+
+VOID ixheaace_drm_put_bits(UWORD8 *ptr_buf, WORD32 pos, UWORD64 value, WORD32 num_bits) {
+  WORD32 i;
+  for (i = 0; i < num_bits; i++) {
+    WORD32 p = pos + i;
+    UWORD32 bit = (UWORD32)((value >> (num_bits - 1 - i)) & 1);
+    if (bit)
+      ptr_buf[p >> 3] |= (UWORD8)(0x80 >> (p & 7));
+    else
+      ptr_buf[p >> 3] &= (UWORD8)~(0x80 >> (p & 7));
+  }
+}
+
+static WORD32 ixheaace_drm_cb_matches(WORD32 sort_cb, WORD32 sect_cb) {
+  if (sect_cb <= 0 || sect_cb > 31 || (sect_cb > 11 && sect_cb < 16)) return 0;
+  if (sort_cb < 11) return (sect_cb == sort_cb) || (sect_cb == sort_cb + 1);
+  return sect_cb == sort_cb;
+}
+
+WORD32 ixheaace_drm_hcr_codewords(const WORD16 *ptr_quant_spec,
+                                  const ixheaace_section_data *pstr_section_data,
+                                  const WORD32 *ptr_sfb_offset, WORD32 grouping_mask,
+                                  ixheaace_huffman_tables *pstr_huffman_tbl,
+                                  ixheaace_drm_cw *ptr_cw, WORD32 *ptr_total_bits,
+                                  WORD32 *ptr_longest) {
+  WORD32 wgl[TRANS_FAC], num_groups = 1, g, i, sort_idx, sfb, w_idx, num_cw = 0;
+  WORD32 sfb_per_group = pstr_section_data->sfb_per_group;
+  WORD32 max_sfb = pstr_section_data->max_sfb_per_grp;
+  UWORD8 tmp_mem[16];
+  ixheaace_bit_buf tmp_bb;
+
+  *ptr_total_bits = 0;
+  *ptr_longest = 0;
+  wgl[0] = 1;
+  if (pstr_section_data->block_type == SHORT_WINDOW) {
+    for (i = 0; i < TRANS_FAC - 1; i++) {
+      if ((grouping_mask >> (TRANS_FAC - 2 - i)) & 1) {
+        wgl[num_groups - 1]++;
+      } else {
+        wgl[num_groups++] = 1;
+      }
+    }
+  }
+
+  for (sort_idx = 0; sort_idx < 22; sort_idx++) {
+    WORD32 sort_cb = ixheaace_drm_presort[sort_idx];
+    for (sfb = 0; sfb < max_sfb; sfb++) {
+      /* width of the sfb in one window */
+      WORD32 width = (ptr_sfb_offset[sfb + 1] - ptr_sfb_offset[sfb]) / wgl[0];
+      for (w_idx = 0; 4 * w_idx < width; w_idx++) {
+        for (g = 0; g < num_groups; g++) {
+          WORD32 k = g * sfb_per_group + sfb, cb = -1;
+          for (i = 0; i < pstr_section_data->num_of_sections; i++) {
+            const ixheaace_section_info *s = &pstr_section_data->section[i];
+            if (k >= s->sfb_start && k < s->sfb_start + s->sfb_cnt) {
+              cb = s->code_book;
+              break;
+            }
+          }
+          if (!ixheaace_drm_cb_matches(sort_cb, cb)) continue;
+          {
+            WORD32 sect_sfb_size = ptr_sfb_offset[k + 1] - ptr_sfb_offset[k];
+            WORD32 inc = (cb < 5) ? 4 : 2;
+            WORD32 group_cws = (4 * wgl[g]) / inc;
+            WORD32 win_width = sect_sfb_size / wgl[g];
+            WORD32 cws_per_unit = 4 / inc;
+            WORD32 cws;
+            for (cws = 0; (cws < group_cws) && ((cws + w_idx * group_cws) < sect_sfb_size);
+                 cws++) {
+              WORD32 sp = ptr_sfb_offset[k] + (cws / cws_per_unit) * win_width + 4 * w_idx +
+                          inc * (cws % cws_per_unit);
+              WORD32 n, b;
+              UWORD64 v = 0;
+              memset(tmp_mem, 0, sizeof(tmp_mem));
+              ia_enhaacplus_enc_create_bitbuffer(&tmp_bb, tmp_mem, sizeof(tmp_mem));
+              ia_enhaacplus_enc_code_values((WORD16 *)(ptr_quant_spec + sp), inc, cb, &tmp_bb,
+                                            pstr_huffman_tbl);
+              n = ia_enhaacplus_enc_get_bits_available(&tmp_bb);
+              for (b = 0; b < n; b++) v = (v << 1) | ((tmp_mem[b >> 3] >> (7 - (b & 7))) & 1);
+              if (num_cw >= IXHEAACE_DRM_MAX_CW) return -1;
+              ptr_cw[num_cw].bits = v;
+              ptr_cw[num_cw].len = n;
+              ptr_cw[num_cw].cb = cb;
+              num_cw++;
+              *ptr_total_bits += n;
+              if (n > *ptr_longest) *ptr_longest = n;
+            }
+          }
+        }
+      }
+    }
+  }
+  return num_cw;
+}
+
+/* one layout attempt with len_reord bits; returns 0 if every codeword is placed and the
+   layout stays within the 64-bit segment/codeword buffers a decoder may use */
+static WORD32 ixheaace_drm_hcr_try(ixheaace_drm_cw *ptr_cw, WORD32 num_cw, WORD32 longest,
+                                   UWORD8 *ptr_out, WORD32 len_reord) {
+  WORD32 left[IXHEAACE_DRM_MAX_CW], right[IXHEAACE_DRM_MAX_CW];
+  WORD32 rem[IXHEAACE_DRM_MAX_CW], partial[IXHEAACE_DRM_MAX_CW];
+  WORD32 num_seg = 0, acc = 0, i, set, num_sets, ok = 0;
+
+  memset(ptr_out, 0, (len_reord + 7) / 8 + 8);
+  if (num_cw == 0) return 0;
+
+  /* segments (8.5.3.3.3.2): one per priority codeword while they fit */
+  for (i = 0; i < num_cw; i++) {
+    WORD32 w = ixheaace_drm_max_cw_len[ptr_cw[i].cb];
+    if (w > longest) w = longest;
+    if (acc + w > len_reord) break;
+    left[num_seg] = acc;
+    right[num_seg] = acc + w - 1;
+    num_seg++;
+    acc += w;
+  }
+  if (num_seg == 0) return -1;
+  if (i < num_cw) {
+    /* the remaining bits extend the last segment; a decoder holds them together with
+       what is left of that segment after its priority codeword: at most 64 bits.
+       faad2 (2.11.4, hcr.c) also merges the two parts wrongly when more than 32 bits
+       are left after the priority codeword, so keep that part within 32 bits. */
+    WORD32 ext = len_reord - acc;
+    WORD32 left_after_pcw = (right[num_seg - 1] - left[num_seg - 1] + 1) - ptr_cw[num_seg - 1].len;
+    if (ext > 0 && (left_after_pcw + ext > 64 || left_after_pcw > 32)) return -2;
+    right[num_seg - 1] = len_reord - 1;
+  }
+
+  for (i = 0; i < num_cw; i++) {
+    rem[i] = ptr_cw[i].len;
+    partial[i] = 0;
+  }
+
+  /* priority codewords, forward at the start of their segment */
+  for (i = 0; i < num_seg; i++) {
+    ixheaace_drm_put_bits(ptr_out, left[i], ptr_cw[i].bits, ptr_cw[i].len);
+    left[i] += ptr_cw[i].len;
+    rem[i] = 0;
+  }
+
+  /* non-priority codewords in sets of num_seg, alternating direction */
+  num_sets = num_cw / num_seg;
+  for (set = 1; set <= num_sets; set++) {
+    WORD32 backwards = set & 1, trial;
+    for (trial = 0; trial < num_seg; trial++) {
+      WORD32 base;
+      for (base = 0; base < num_seg; base++) {
+        WORD32 s = (trial + base) % num_seg;
+        WORD32 c = num_seg + base + (set - 1) * num_seg;
+        WORD32 free_bits, n;
+        if (c >= num_cw) break;
+        free_bits = right[s] - left[s] + 1;
+        if (rem[c] <= 0 || free_bits <= 0) continue;
+        if (free_bits + partial[c] > 64) return -3;
+        n = (rem[c] < free_bits) ? rem[c] : free_bits;
+        {
+          /* next n bits of the codeword (MSB part first) */
+          UWORD64 piece = (ptr_cw[c].bits >> (rem[c] - n)) & ((((UWORD64)1) << n) - 1);
+          if (backwards) {
+            WORD32 b;
+            for (b = 0; b < n; b++) {
+              ixheaace_drm_put_bits(ptr_out, right[s] - b, (piece >> (n - 1 - b)) & 1, 1);
+            }
+            right[s] -= n;
+          } else {
+            ixheaace_drm_put_bits(ptr_out, left[s], piece, n);
+            left[s] += n;
+          }
+        }
+        rem[c] -= n;
+        if (rem[c] > 0) partial[c] += n;
+      }
+    }
+  }
+  for (i = 0; i < num_cw; i++) {
+    if (rem[i] > 0) ok = -4;
+  }
+  return ok;
+}
+
+WORD32 ixheaace_drm_hcr_place(ixheaace_drm_cw *ptr_cw, WORD32 num_cw, WORD32 longest,
+                              UWORD8 *ptr_out, WORD32 *ptr_len_reord) {
+  WORD32 pad, base_len = *ptr_len_reord;
+  /* the plain layout almost always works; otherwise grow the area bit by bit */
+  for (pad = 0; pad < 64; pad++) {
+    if (base_len + pad >= (1 << IXHEAACE_DRM_LEN_REORD_BITS)) break;
+    if (ixheaace_drm_hcr_try(ptr_cw, num_cw, longest, ptr_out, base_len + pad) == 0) {
+      *ptr_len_reord = base_len + pad;
+      return 0;
+    }
+  }
+  return -1;
+}
