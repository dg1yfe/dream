 #pragma once
@@ -39,3 +40,17 @@ IA_ERRORCODE ia_enhaacplus_enc_write_bitstream(
     const UWORD8 *ptr_anc_bytes, ixheaace_aac_tables *pstr_aac_tables, FLAG flag_last_element,
     WORD32 *write_program_config_element, WORD32 i_num_coup_channels, WORD32 i_channels_mask,
     WORD32 i_samp_freq, WORD32 ele_idx, WORD32 aot, WORD32 *total_fill_bits);
+
+/* DRM (ETSI ES 201 980) access unit: aac_crc_bits, ER AAC element with VCB11 and HCR,
+   padding, SBR data bit-reversed at the end (see ixheaace_drm.c). The AU (CRC byte
+   included) is at least min_bytes and at most max_bytes long (0: no limit). Returns
+   IA_EXHEAACE_EXE_FATAL_INVALID_OUT_BYTES if the data does not fit max_bytes. */
+IA_ERRORCODE ixheaace_drm_write_au(ixheaace_element_info *pstr_element_info,
+                                   ixheaace_qc_out *pstr_qc_out, ixheaace_psy_out *pstr_psy_out,
+                                   ixheaace_aac_tables *pstr_aac_tables,
+                                   const UWORD8 *ptr_sbr_payload, WORD32 sbr_bits,
+                                   WORD32 min_bytes, WORD32 max_bytes, UWORD8 *ptr_out,
+                                   WORD32 out_size, WORD32 *ptr_out_bytes);
+
+/* bits of the DRM section data (5-bit codebooks; VCB11: one section per sfb, no length) */
+WORD32 ixheaace_drm_section_bits(const ixheaace_section_data *pstr_section_data);
