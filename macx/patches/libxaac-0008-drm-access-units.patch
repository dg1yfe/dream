+/* ---------------------------------------------------------------------------------------
+ * DRM access unit (ETSI ES 201 980 5.3.1 / ISO/IEC 14496-3 ER AAC with
+ * aacSectionDataResilienceFlag = 1 (VCB11), aacSpectralDataResilienceFlag = 1 (HCR),
+ * aacScalefactorDataResilienceFlag = 0). Element syntax as aac_scalable_main_element()
+ * of the main layer: header, per channel tns_data_present/ltp_data_present/side info with
+ * the HCR lengths, then tns_data(), the CRC-protected part ends here, then the reordered
+ * spectral data. Added for DREAM.
+ * ------------------------------------------------------------------------------------- */
+#include "ixheaace_drm.h"
+
+static WORD32 ixheaace_drm_sect_len_bits(WORD32 cnt, WORD32 block_type) {
+  WORD32 esc = (block_type == SHORT_WINDOW) ? SECT_ESC_VAL_SHORT : SECT_ESC_VAL_LONG;
+  WORD32 bits = (block_type == SHORT_WINDOW) ? SECT_BITS_SHORT : SECT_BITS_LONG;
+  return (cnt / esc + 1) * bits;
+}
+
+WORD32 ixheaace_drm_section_bits(const ixheaace_section_data *pstr_section_data) {
+  WORD32 i, bits = 0;
+  for (i = 0; i < pstr_section_data->num_of_sections; i++) {
+    WORD32 cb = pstr_section_data->section[i].code_book;
+    WORD32 cnt = pstr_section_data->section[i].sfb_cnt;
+    if (cb == CODE_BCK_ESC_NO) {
+      bits += IXHEAACE_DRM_SECT_CB_BITS * cnt;
+    } else {
+      bits += IXHEAACE_DRM_SECT_CB_BITS +
+              ixheaace_drm_sect_len_bits(cnt, pstr_section_data->block_type);
+    }
+  }
+  return bits;
+}
+
+static VOID ixheaace_drm_encode_section_data(const ixheaace_section_data *pstr_section_data,
+                                             ixheaace_bit_buf_handle pstr_bs) {
+  WORD32 i, j;
+  WORD32 esc = (pstr_section_data->block_type == SHORT_WINDOW) ? SECT_ESC_VAL_SHORT
+                                                                : SECT_ESC_VAL_LONG;
+  WORD32 len_bits =
+      (pstr_section_data->block_type == SHORT_WINDOW) ? SECT_BITS_SHORT : SECT_BITS_LONG;
+  for (i = 0; i < pstr_section_data->num_of_sections; i++) {
+    WORD32 cb = pstr_section_data->section[i].code_book;
+    WORD32 cnt = pstr_section_data->section[i].sfb_cnt;
+    if (cb == CODE_BCK_ESC_NO) {
+      /* VCB11: every ESC sfb is a section of its own, sect_len is implicit (1) */
+      for (j = 0; j < cnt; j++) ixheaace_write_bits(pstr_bs, cb, IXHEAACE_DRM_SECT_CB_BITS);
+    } else {
+      ixheaace_write_bits(pstr_bs, cb, IXHEAACE_DRM_SECT_CB_BITS);
+      while (cnt >= esc) {
+        ixheaace_write_bits(pstr_bs, esc, (UWORD8)len_bits);
+        cnt -= esc;
+      }
+      ixheaace_write_bits(pstr_bs, cnt, (UWORD8)len_bits);
+    }
+  }
+}
+
+static WORD32 ixheaace_drm_tns_present(const ixheaace_temporal_noise_shaping_params *pstr_tns,
+                                       WORD32 block_type) {
+  WORD32 i, num_windows = (block_type == SHORT_WINDOW) ? TRANS_FAC : 1;
+  for (i = 0; i < num_windows; i++)
+    if (pstr_tns->tns_active[i] == 1) return 1;
+  return 0;
+}
+
+/* tns_data() body (the presence flag is sent separately in the DRM element) */
+static VOID ixheaace_drm_encode_tns_body(ixheaace_temporal_noise_shaping_params tns,
+                                         WORD32 block_type, ixheaace_bit_buf_handle pstr_bs) {
+  WORD32 i, k, coef_bits;
+  WORD32 num_windows = (block_type == SHORT_WINDOW) ? TRANS_FAC : 1;
+  WORD32 is_short = (block_type == SHORT_WINDOW);
+  for (i = 0; i < num_windows; i++) {
+    ixheaace_write_bits(pstr_bs, tns.tns_active[i], (UWORD8)(is_short ? 1 : 2));
+    if (tns.tns_active[i]) {
+      UWORD32 tmp = ((tns.coef_res[i] == 4 ? 1 : 0) << ((is_short ? 4 : 6) + (is_short ? 3 : 5))) |
+                    tns.length[i] << (is_short ? 3 : 5) | tns.order[i];
+      ixheaace_write_bits(pstr_bs, tmp, (UWORD8)(1 + (is_short ? 4 : 6) + (is_short ? 3 : 5)));
+      if (tns.order[i]) {
+        ixheaace_write_bits(pstr_bs, FILTER_DIRECTION, 1);
+        if (tns.coef_res[i] == 4) {
+          coef_bits = 3;
+          for (k = 0; k < tns.order[i]; k++) {
+            if (tns.coef[i * TEMPORAL_NOISE_SHAPING_MAX_ORDER_SHORT + k] > 3 ||
+                tns.coef[i * TEMPORAL_NOISE_SHAPING_MAX_ORDER_SHORT + k] < -4) {
+              coef_bits = 4;
+              break;
+            }
+          }
+        } else {
+          coef_bits = 2;
+          for (k = 0; k < tns.order[i]; k++) {
+            if (tns.coef[i * TEMPORAL_NOISE_SHAPING_MAX_ORDER_SHORT + k] > 1 ||
+                tns.coef[i * TEMPORAL_NOISE_SHAPING_MAX_ORDER_SHORT + k] < -2) {
+              coef_bits = 3;
+              break;
+            }
+          }
+        }
+        ixheaace_write_bits(pstr_bs, -(coef_bits - tns.coef_res[i]), 1);
+        for (k = 0; k < tns.order[i]; k++) {
+          static const WORD32 rmask[] = {0, 1, 3, 7, 15};
+          ixheaace_write_bits(pstr_bs,
+                              tns.coef[i * TEMPORAL_NOISE_SHAPING_MAX_ORDER_SHORT + k] &
+                                  rmask[coef_bits],
+                              (UWORD8)coef_bits);
+        }
+      }
+    }
+  }
+}
