+    num_cw = ixheaace_drm_hcr_codewords(qc_ch[ch]->quant_spec, &qc_ch[ch]->section_data,
+                                        psy_ch[ch]->sfb_offsets, qc_ch[ch]->grouping_mask,
+                                        pstr_aac_tables->pstr_huff_tab, cw[ch], &total,
+                                        &longest[ch]);
+    if (num_cw < 0) return IA_EXHEAACE_EXE_FATAL_INVALID_HUFFMAN_BITS;
+    len_reord[ch] = total;
+    while (ixheaace_drm_hcr_place(cw[ch], num_cw, longest[ch], hcr_buf[ch], &len_reord[ch])) {
+      /* Rare (very few, very long escape codewords): a decoder may hold at most 64 bits of
+         a codeword plus segment. Limit the largest spectral values and retry; this only
+         shortens codewords, so the frame still fits. Values <= 15 never escape. */
+      WORD32 max_q = 0, lim, n_lines = psy_ch[ch]->sfb_offsets[qc_ch[ch]->section_data.sfb_cnt];
+      WORD16 *q = qc_ch[ch]->quant_spec;
+      for (i = 0; i < n_lines; i++) {
+        WORD32 a = q[i] < 0 ? -q[i] : q[i];
+        if (a > max_q) max_q = a;
+      }
+      if (max_q <= 15) return IA_EXHEAACE_EXE_FATAL_INVALID_HUFFMAN_BITS;
+      lim = max_q / 2 > 15 ? max_q / 2 : 15;
+      for (i = 0; i < n_lines; i++) {
+        if (q[i] > lim) q[i] = (WORD16)lim;
+        if (q[i] < -lim) q[i] = (WORD16)-lim;
+      }
+      num_cw = ixheaace_drm_hcr_codewords(qc_ch[ch]->quant_spec, &qc_ch[ch]->section_data,
+                                          psy_ch[ch]->sfb_offsets, qc_ch[ch]->grouping_mask,
+                                          pstr_aac_tables->pstr_huff_tab, cw[ch], &total,
+                                          &longest[ch]);
+      if (num_cw < 0) return IA_EXHEAACE_EXE_FATAL_INVALID_HUFFMAN_BITS;
+      len_reord[ch] = total;
+    }
+  }
+
+  memset(ptr_out, 0, out_size);
+  pstr_bs = ia_enhaacplus_enc_create_bitbuffer(&bb, ptr_out, out_size);
+  ixheaace_write_bits(pstr_bs, 0, 8); /* aac_crc_bits, filled in below */
+
+  /* aac_scalable_main_header() */
+  {
+    ixheaace_section_data *sd = &qc_ch[0]->section_data;
+    ixheaace_write_bits(pstr_bs, ICS_RESERVED_BIT, 1);
+    ixheaace_write_bits(pstr_bs, sd->block_type, 2);
+    ixheaace_write_bits(pstr_bs, qc_ch[0]->win_shape, 1);
+    if (sd->block_type == SHORT_WINDOW) {
+      ixheaace_write_bits(pstr_bs, mute ? 0 : sd->max_sfb_per_grp, 4);
+      ixheaace_write_bits(pstr_bs, qc_ch[0]->grouping_mask, TRANS_FAC - 1);
+    } else {
+      ixheaace_write_bits(pstr_bs, mute ? 0 : sd->max_sfb_per_grp, 6);
+    }
+    if (nch == 2 && mute) {
+      ixheaace_write_bits(pstr_bs, SI_MS_MASK_NONE, 2);
+    } else if (nch == 2) {
+      ia_enhaacplus_enc_encode_ms_info(sd->sfb_cnt, sd->sfb_per_group, sd->max_sfb_per_grp,
+                                       pstr_psy_out->psy_out_element.tools_info.ms_digest,
+                                       pstr_psy_out->psy_out_element.tools_info.ms_mask,
+                                       pstr_bs);
+    }
+  }
+  for (ch = 0; ch < nch; ch++) {
+    ixheaace_section_data *sd = &qc_ch[ch]->section_data;
+    ixheaace_write_bits(
+        pstr_bs, mute ? 0 : ixheaace_drm_tns_present(&psy_ch[ch]->tns_info, sd->block_type), 1);
+    ixheaace_write_bits(pstr_bs, 0, 1); /* ltp_data_present */
+    ia_enhaacplus_enc_encode_global_gain(qc_ch[ch]->global_gain, -1,
+                                         qc_ch[ch]->scalefactor[sd->first_scf], pstr_bs);
+    if (!mute) {
+      ixheaace_drm_encode_section_data(sd, pstr_bs);
+      ia_enhaacplus_enc_encode_scalefactor_data(qc_ch[ch]->max_val_in_sfb, sd,
+                                                qc_ch[ch]->scalefactor, pstr_bs,
+                                                pstr_aac_tables->pstr_huff_tab);
+    }
+    ixheaace_write_bits(pstr_bs, len_reord[ch], IXHEAACE_DRM_LEN_REORD_BITS);
+    ixheaace_write_bits(pstr_bs, longest[ch], IXHEAACE_DRM_LEN_LONGEST_BITS);
+  }
+  for (ch = 0; ch < nch; ch++) {
+    if (!mute &&
+        ixheaace_drm_tns_present(&psy_ch[ch]->tns_info, qc_ch[ch]->section_data.block_type)) {
+      ixheaace_drm_encode_tns_body(psy_ch[ch]->tns_info, qc_ch[ch]->section_data.block_type,
+                                   pstr_bs);
+    }
+  }
+  crc_end = ia_enhaacplus_enc_get_bits_available(pstr_bs);
+
+  core_bits = crc_end;
+  for (ch = 0; ch < nch; ch++) core_bits += len_reord[ch];
+  if (max_bytes <= 0 || max_bytes > out_size) max_bytes = out_size;
+  if (min_bytes > max_bytes) min_bytes = max_bytes;
+
+  if (core_bits + sbr_bits > 8 * max_bytes) {
+    /* The frame came out larger than the transmitter allows. Rare at normal rates (HCR
+       layout padding, an exact last access unit of a super frame); at very low rates the
+       side information alone may not fit. Step by step: silence the highest non-zero
+       spectral lines of the larger channel; then send an empty spectrum (max_sfb = 0);
+       last, leave out the SBR data (the decoder's SBR CRC check fails and it conceals). */
+    if (!mute && trim_rounds < 64) {
+      WORD32 k;
+      trim_rounds++;
+      for (k = 0; k < nch; k++) {
+        WORD32 c = (nch == 2 && (len_reord[1] > len_reord[0]) != (k == 1)) ? 1 : 0;
+        WORD32 n_lines = psy_ch[c]->sfb_offsets[qc_ch[c]->section_data.sfb_cnt];
+        WORD32 nz = 0, n_zero, n_zeroed = 0;
+        WORD16 *q = qc_ch[c]->quant_spec;
+        for (i = 0; i < n_lines; i++) nz += (q[i] != 0);
+        n_zero = nz / 8 > 4 ? nz / 8 : 4;
+        for (i = n_lines - 1; i >= 0 && n_zeroed < n_zero; i--) {
+          if (q[i] != 0) {
+            q[i] = 0;
+            n_zeroed++;
+          }
+        }
+        if (n_zeroed > 0) goto retry;
+      }
+    }
+    if (!mute) {
+      mute = 1;
+      goto retry;
+    }
+    sbr_bits = 0;
+  }
+
+  /* reordered_spectral_data() */
+  pos = crc_end;
+  for (ch = 0; ch < nch; ch++) {
+    if (pos + len_reord[ch] > out_size * 8) return IA_EXHEAACE_EXE_FATAL_INVALID_OUT_BYTES;
+    for (i = 0; i < len_reord[ch]; i++) {
+      ixheaace_drm_put_bits(ptr_out, pos + i, (hcr_buf[ch][i >> 3] >> (7 - (i & 7))) & 1, 1);
+    }
+    pos += len_reord[ch];
+  }
+
+  total_bits = ((core_bits + sbr_bits + 7) / 8) * 8;
+  if (min_bytes > 0 && total_bits < 8 * min_bytes) total_bits = 8 * min_bytes;
+  if ((max_bytes > 0 && total_bits > 8 * max_bytes) || total_bits > out_size * 8) {
+    *ptr_out_bytes = 0;
+    return IA_EXHEAACE_EXE_FATAL_INVALID_OUT_BYTES;
+  }
+  /* zero padding in between; SBR data read backwards from the last bit of the AU */
+  for (i = 0; i < sbr_bits; i++) {
+    ixheaace_drm_put_bits(ptr_out, total_bits - 1 - i,
+                          (ptr_sbr_payload[i >> 3] >> (7 - (i & 7))) & 1, 1);
+  }
+  ptr_out[0] = ixheaace_drm_crc8(ptr_out, 8, crc_end - 8);
+  *ptr_out_bytes = total_bits / 8;
+  return IA_NO_ERROR;
+}
