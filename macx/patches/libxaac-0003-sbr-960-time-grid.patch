 static VOID ixheaace_calc_cmon_border(WORD32 *ptr_cmon_border_idx, WORD32 *ptr_tran_idx,
                                       WORD32 *ptr_a_borders, WORD32 *ptr_border_vec_len,
-                                      WORD32 tran
+                                      WORD32 tran, WORD32 num_time_slots
 
 ) {
   WORD32 i;
 
   for (i = 0; i < *ptr_border_vec_len; i++) {
-    if (ptr_a_borders[i] >= 16) {
+    if (ptr_a_borders[i] >= num_time_slots) {
       *ptr_cmon_border_idx = i;
       break;
     }
@@ -376,6 +377,48 @@ static VOID ixheaace_calc_cmon_border(WORD32 *ptr_cmon_border_idx, WORD32 *ptr_t
   }
 }
 
+/* Post-transient fill, spreading and common-border search. The common border becomes
+   absBordTrail of this frame and absBordLead of the next one; both are sent as offsets 0..3
+   (bs_var_bord_1 = absBordTrail - numTimeSlots, bs_var_bord_0, 2 bits each, ISO/IEC 14496-3
+   4.6.18.3.3). The fmax values are tuned for 16 time slots; with 15 (960-sample frames) the
+   post fill can overshoot, so it is redone with the next smaller even segment length. */
+static VOID ixheaace_fill_post_and_cmon(WORD32 *ptr_parts, WORD32 *ptr_d, WORD32 dmax,
+                                        WORD32 dmin, WORD32 *ptr_v_bord, WORD32 *ptr_length_v_bord,
+                                        ixheaace_freq_res *ptr_v_freq, WORD32 *ptr_length_v_freq,
+                                        WORD32 bmax, WORD32 fmax, WORD32 *ptr_spread_flag,
+                                        WORD32 allow_spread, WORD32 *ptr_i_cmon, WORD32 *ptr_i_tran,
+                                        WORD32 tran, WORD32 num_time_slots) {
+  WORD32 save_bord[2 * IXHEAACE_MAX_ENV_VARVAR + 1];
+  ixheaace_freq_res save_freq[2 * IXHEAACE_MAX_ENV_VARVAR + 1];
+  WORD32 save_len_bord = *ptr_length_v_bord, save_len_freq = *ptr_length_v_freq;
+  WORD32 save_spread = *ptr_spread_flag;
+
+  memcpy(save_bord, ptr_v_bord, sizeof(save_bord));
+  memcpy(save_freq, ptr_v_freq, sizeof(save_freq));
+  for (;;) {
+    ixheaace_fill_Frame_Post(ptr_parts, ptr_d, dmax, ptr_v_bord, ptr_length_v_bord, ptr_v_freq,
+                             ptr_length_v_freq, bmax, fmax, num_time_slots);
+
+    if (*ptr_parts == 1 && *ptr_d < dmin) {
+      ixheaace_special_case(ptr_spread_flag, allow_spread, ptr_v_bord, ptr_length_v_bord,
+                            ptr_v_freq, ptr_length_v_freq, ptr_parts, *ptr_d);
+    }
+
+    ixheaace_calc_cmon_border(ptr_i_cmon, ptr_i_tran, ptr_v_bord, ptr_length_v_bord, tran,
+                              num_time_slots);
+
+    if (ptr_v_bord[*ptr_i_cmon] <= num_time_slots + 3 || fmax <= 2) {
+      break;
+    }
+    memcpy(ptr_v_bord, save_bord, sizeof(save_bord));
+    memcpy(ptr_v_freq, save_freq, sizeof(save_freq));
+    *ptr_length_v_bord = save_len_bord;
+    *ptr_length_v_freq = save_len_freq;
+    *ptr_spread_flag = save_spread;
+    fmax -= 2;
+  }
+}
