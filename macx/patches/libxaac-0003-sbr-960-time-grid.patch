From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DREAM <dream@invalid>
Date: Sun, 15 Nov 2026 14:35:01 +0100
Subject: [PATCH] SBR 960: 15-slot time grid, transient detector and envelope
 buffers

HE-AAC with frameLengthFlag=1 has numTimeSlots = 15 (30 QMF slots of RATE 2,
ISO/IEC 14496-3 4.6.18). The envelope extractor, transient detector, frame splitter,
missing-harmonics detector and the time grid generator assumed 16 slots: energies of a
960 frame were written into a 16-row half buffer (one stale row), and grids were built and
written with "- 16" (bs_var_bord_1 = absBordTrail - numTimeSlots), so FIXVAR/VARFIX/VARVAR
borders were shifted against the decoder's grid. All of these now use the frame's
numTimeSlots. The fmax segment lengths of the grid generator are tuned for 16 slots and can
put the common border at 19 > numTimeSlots + 3 with 15 slots (invalid 2-bit field); the
post-transient fill is now redone with the next smaller even segment length in that case
(0 invalid grids in 25k test frames, was ~10%). The SBR header period uses the 1920-sample
SBR frame. 1024 framing is bit-exact with the unpatched encoder.
---
 encoder/ixheaace_sbr_env_est_init.c    | 24 ++++++-
 encoder/ixheaace_sbr_frame_info_gen.c  | 98 ++++++++++++++++++--------
 encoder/ixheaace_sbr_frame_info_gen.h  |  1 +
 encoder/ixheaace_sbr_main.c            | 14 +++-
 encoder/ixheaace_sbr_tran_det.c        |  7 ++
 encoder/ixheaace_sbr_write_bitstream.c |  7 +-
 6 files changed, 113 insertions(+), 38 deletions(-)

diff --git a/encoder/ixheaace_sbr_env_est_init.c b/encoder/ixheaace_sbr_env_est_init.c
index 2f2d8d1..fbbe02e 100644
--- a/encoder/ixheaace_sbr_env_est_init.c
+++ b/encoder/ixheaace_sbr_env_est_init.c
@@ -72,6 +72,9 @@ ixheaace_create_extract_sbr_envelope(WORD32 ch,
   WORD32 time_slots = 16;
   WORD32 sbr_ratio_idx = pstr_sbr_ext_env->sbr_ratio_idx;
   WORD32 qmf_time_slots = IXHEAACE_QMF_TIME_SLOTS;
+  /* rows of the QMF r/i buffers that get pointers, and the per-channel stride (the PS downmix
+     relies on the 32-slot layout, so 960 keeps it and only uses 30 rows) */
+  WORD32 r_rows, r_stride = IXHEAACE_QMF_TIME_SLOTS;
   FLOAT32 *ptr_buffer = NULL;
   FLOAT32 *ptr_i_buffer = NULL;
   memset(pstr_sbr_ext_env, 0, sizeof(ixheaace_str_sbr_extr_env));
@@ -101,6 +104,14 @@ ixheaace_create_extract_sbr_envelope(WORD32 ch,
       y_buffer_write_offset = QMF_TIME_SLOTS_USAC_4_1;
       no_cols = qmf_time_slots;
     }
+    if ((sbr_codec == HEAAC_SBR) && frame_flag_480) {
+      /* HE-AAC with 960-sample core frames (frameLengthFlag=1, e.g. DRM): ISO/IEC 14496-3
+         4.6.18.2: numTimeSlots = 15 SBR slots of RATE=2 QMF slots = 30 QMF slots per frame */
+      qmf_time_slots = 30;
+      y_buffer_write_offset = 30;
+      no_cols = 30;
+      time_slots = 15;
+    }
 
     pstr_sbr_ext_env->y_buffer_write_offset = y_buffer_write_offset;
 
@@ -152,9 +163,16 @@ ixheaace_create_extract_sbr_envelope(WORD32 ch,
            IXHEAACE_QMF_CHANNELS * sizeof(pstr_sbr_ext_env->ptr_y_buffer[0]));
   }
 
-  ptr_buffer = &ptr_sbr_env_r_buf[ch * qmf_time_slots * IXHEAACE_QMF_CHANNELS];
-  ptr_i_buffer = &ptr_sbr_env_i_buf[ch * qmf_time_slots * IXHEAACE_QMF_CHANNELS];
-  for (i = 0; i < r_buffer_length; i++) {
+  r_rows = r_buffer_length;
+  if (qmf_time_slots > IXHEAACE_QMF_TIME_SLOTS) {
+    r_stride = qmf_time_slots;
+  }
+  if ((sbr_codec == HEAAC_SBR) && (r_rows < IXHEAACE_QMF_TIME_SLOTS)) {
+    r_rows = IXHEAACE_QMF_TIME_SLOTS;
+  }
+  ptr_buffer = &ptr_sbr_env_r_buf[ch * r_stride * IXHEAACE_QMF_CHANNELS];
+  ptr_i_buffer = &ptr_sbr_env_i_buf[ch * r_stride * IXHEAACE_QMF_CHANNELS];
+  for (i = 0; i < r_rows; i++) {
     pstr_sbr_ext_env->ptr_r_buffer[i] = ptr_buffer + i * IXHEAACE_QMF_CHANNELS;
     memset(pstr_sbr_ext_env->ptr_r_buffer[i], 0,
            IXHEAACE_QMF_CHANNELS * sizeof(pstr_sbr_ext_env->ptr_r_buffer[0]));
diff --git a/encoder/ixheaace_sbr_frame_info_gen.c b/encoder/ixheaace_sbr_frame_info_gen.c
