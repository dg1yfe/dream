From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DREAM <dream@invalid>
Date: Sun, 15 Nov 2026 14:35:01 +0100
Subject: [PATCH] AAC-LC 960: MDCT output scale and 120-sample short sine
 window

The 960/120-point MDCTs (ixheaace_mdct_960, ixheaace_mdct_120) scaled their output by
22/7 instead of 4, the factor used by the 1024/128-point path, so every 960-sample frame
was coded 2.1 dB too quiet (coefficient power ratio 960/1024 measured 0.579 instead of
0.9375). The table short_window_sine_120 held a KBD(alpha=6) window while the bitstream
signals window_shape = SINE for short/start/stop blocks; it now holds
w(n) = sin(pi/240 (n + 1/2)) (ISO/IEC 14496-3 4.6.11.3.2), so the decoder's TDAC cancels
the aliasing around transients. 1024 framing is unchanged.
---
 encoder/ixheaace_fft.c |  7 +++--
 encoder/ixheaace_rom.c | 64 ++++++++++++++++++++++--------------------
 2 files changed, 39 insertions(+), 32 deletions(-)

diff --git a/encoder/ixheaace_fft.c b/encoder/ixheaace_fft.c
index 92ff7c0..68c573d 100644
--- a/encoder/ixheaace_fft.c
+++ b/encoder/ixheaace_fft.c
@@ -2118,7 +2118,10 @@ static VOID ixheaace_post_twiddle_960(FLOAT32 *ptr_out, FLOAT32 *ptr_x,
 
 static VOID ixheaace_mdct_960(FLOAT32 *ptr_input_flt, WORD8 *ptr_scratch) {
   FLOAT32 *ptr_scratch_flt = (FLOAT32 *)ptr_scratch;
-  FLOAT32 const_mult_fac = 3.142857143f;
+  /* Output scale must match the 1024/128 MDCT path (ixheaace_mdct) so that the decoder, which
+     uses the standard IMDCT normalisation for every frame length, reconstructs the input level.
+     The previous value 3.142857143f (22/7) left 960-sample frames 2.1 dB too quiet. */
+  FLOAT32 const_mult_fac = 4.0f;
   FLOAT32 *ptr_data = ptr_input_flt;
   WORD32 k;
 
@@ -2141,7 +2144,7 @@ static VOID ixheaace_mdct_120(FLOAT32 *ptr_input_flt, WORD8 *ptr_scratch) {
   WORD32 n, k;
   WORD32 n_by_2;
   FLOAT32 *ptr_scratch_flt = (FLOAT32 *)ptr_scratch;
-  FLOAT32 const_mltfac = 3.142857143f;
+  FLOAT32 const_mltfac = 4.0f; /* same scale as the 128-sample short MDCT, see ixheaace_mdct_960 */
   FLOAT32 *ptr_data = ptr_input_flt;
   n = 120;
   n_by_2 = n >> 1;
diff --git a/encoder/ixheaace_rom.c b/encoder/ixheaace_rom.c
index 532fee9..31d8e44 100644
--- a/encoder/ixheaace_rom.c
+++ b/encoder/ixheaace_rom.c
@@ -3175,37 +3175,41 @@ const FLOAT32 short_window_sine[FRAME_LEN_SHORT_128] = {
     +9.98475580573295e-001f, +9.99077727752645e-001f, +9.99529417501093e-001f,
     +9.99830581795823e-001f, +9.99981175282601e-001f};
 
+/* Short sine window for 960-sample frames (120-sample short blocks), ISO/IEC 14496-3
+   4.6.11.3.2: w(n) = sin(pi / 240 * (n + 0.5)), n = 0..119. The bitstream signals
+   window_shape = SINE for short blocks, so the analysis window must be the sine window
+   (this table previously held a KBD(alpha=6) window). */
